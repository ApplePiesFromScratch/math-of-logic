from __future__ import annotations
import math
from dataclasses import dataclass, field
from typing import Callable, List, Optional, Dict

TOL = 1e-10


# ══════════════════════════════════════════════════════════════════════════════
# CARRIER DEFINITION
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class Carrier:
    """
    A complete formal logical system as a carrier set.

    Fields:
        id              Machine-readable identifier
        name            Human-readable name
        tradition       Cultural/intellectual tradition
        period          Approximate origin (negative = BCE)
        origin          Key figure(s)

        V               Value space (list of floats)
        V_desc          Plain-language description of V
        designated      Values that count as "true/holding"

        not_fn          NOT operation: V -> V
        and_fn          AND operation: V x V -> V
        or_fn           OR operation: V x V -> V
        theta           Coherence threshold

        special         Additional named operations
        parents         Parent carrier IDs (what this branches from)
        children        Child carrier IDs (what branches from this)

        key_insight     The core idea that distinguishes this carrier
        ml_note         Genuine ML application
        cultural_note   Context, caveats, and honest scope
    """
    id:           str
    name:         str
    tradition:    str
    period:       str
    origin:       str

    V:            List[float]
    V_desc:       str
    designated:   List[float]

    not_fn:       Callable
    and_fn:       Callable
    or_fn:        Callable
    theta:        float = 1.0

    special:      Dict[str, Callable] = field(default_factory=dict)
    parents:      List[str]           = field(default_factory=list)
    children:     List[str]           = field(default_factory=list)

    key_insight:  str = ""
    ml_note:      str = ""
    cultural_note:str = ""


# ══════════════════════════════════════════════════════════════════════════════
# LAW CHECKING UTILITIES
# ══════════════════════════════════════════════════════════════════════════════

def check_lnc(c: Carrier) -> tuple:
    failures = [v for v in c.V if abs(c.and_fn(v, c.not_fn(v))) > TOL]
    return (len(failures) == 0, failures[:5])

def check_lem(c: Carrier) -> tuple:
    top = max(c.V)
    failures = [v for v in c.V if abs(c.or_fn(v, c.not_fn(v)) - top) > TOL]
    return (len(failures) == 0, failures[:5])

def check_dn(c: Carrier) -> tuple:
    failures = [v for v in c.V if abs(c.not_fn(c.not_fn(v)) - v) > TOL]
    return (len(failures) == 0, failures[:5])

def liar_solutions(c: Carrier) -> List[float]:
    return [v for v in c.V if abs(v - c.not_fn(v)) < TOL]

def check_laws(c: Carrier) -> Dict:
    lnc, lnc_f = check_lnc(c)
    lem, lem_f = check_lem(c)
    dn,  dn_f  = check_dn(c)
    liar       = liar_solutions(c)
    return {
        "carrier":  c.name,
        "LNC":      ("forced" if lnc else f"fails at {lnc_f}"),
        "LEM":      ("forced" if lem else f"fails at {lem_f}"),
        "DN":       ("forced" if dn  else f"fails at {dn_f}"),
        "Liar":     (f"resolved at {liar}" if liar else "paradox (no fixed point)"),
    }

def compare_carriers(c1: Carrier, c2: Carrier):
    r1, r2 = check_laws(c1), check_laws(c2)
    print(f"\nDiff: {c1.name}  vs  {c2.name}")
    print("─" * 60)
    for k in ["LNC", "LEM", "DN", "Liar"]:
        changed = "  ← CHANGED" if r1[k] != r2[k] else ""
        print(f"  {k:<8} {c1.name[:20]}: {str(r1[k])[:25]:<26}  {c2.name[:20]}: {str(r2[k])[:25]}{changed}")

def report(c: Carrier):
    laws = check_laws(c)
    print(f"\n{'═'*60}")
    print(f"  {c.name}")
    print(f"  {c.tradition}  |  {c.period}  |  {c.origin}")
    print(f"  V = {c.V[:8]}{'...' if len(c.V)>8 else ''}")
    print(f"  theta = {c.theta}")
    print(f"{'─'*60}")
    for k in ["LNC","LEM","DN","Liar"]:
        mark = "✓" if "forced" in str(laws[k]) or "resolved" in str(laws[k]) else "✗"
        print(f"  {mark} {k}: {laws[k]}")
    if c.special:
        print(f"  Special ops: {list(c.special.keys())}")
    if c.key_insight:
        print(f"\n  ▶ {c.key_insight}")
    if c.ml_note:
        print(f"  ML: {c.ml_note}")


# ══════════════════════════════════════════════════════════════════════════════
# GENEALOGY
# ══════════════════════════════════════════════════════════════════════════════

def genealogy(carrier_id: str, registry: Dict, depth=0, seen=None) -> str:
    if seen is None: seen = set()
    if carrier_id in seen: return ""
    seen.add(carrier_id)
    c = registry.get(carrier_id)
    if not c: return ""
    lines = ["  " * depth + f"{'└─ ' if depth else ''}{c.name}  [{c.period}]"]
    for child_id in c.children:
        sub = genealogy(child_id, registry, depth+1, seen)
        if sub: lines.append(sub)
    return "\n".join(lines)



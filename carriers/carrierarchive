def print_all():
    for carrier_id, c in REGISTRY.items():
        laws = check_laws(c)
        print(f"\n{c.name:<50}  [{c.tradition}  |  {c.period}]")
        print(f"  V = {str(c.V[:4])}...  theta = {c.theta}")
        for k in ['LNC','LEM','DN','Liar']:
            mark = '✓' if ('forced' in str(laws[k]) or 'resolved' in str(laws[k])) else '✗'
            print(f"  {mark} {k}: {str(laws[k])[:60]}")

def print_genealogy():
    print("\nCarrier genealogy (roots only, then branches):\n")
    roots = [c for c in REGISTRY.values() if not c.parents]
    for r in roots:
        print(genealogy(r.id, REGISTRY))

def carriers_by_tradition():
    from collections import defaultdict
    groups = defaultdict(list)
    for c in REGISTRY.values():
        groups[c.tradition].append(c.name)
    for tradition, names in sorted(groups.items()):
        print(f"\n{tradition}:")
        for n in names:
            print(f"  {n}")

def search(query: str):
    """Search carriers by name, tradition, or content."""
    q = query.lower()
    return [c for c in REGISTRY.values()
            if q in c.name.lower() or q in c.tradition.lower()
            or q in c.key_insight.lower() or q in c.ml_note.lower()
            or q in c.id.lower()]


